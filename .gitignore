# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Unanchored too: vitest writes a cache under evals/node_modules/.vite when it
# runs with the eval config, and the leading-slash rule above does not reach it.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# eval scratch — the raw per-task shards a run writes. The committed evidence is
# evals/RESULTS.md plus the snapshot in evals/baseline/.
/evals/results/

# playwright e2e
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
tests/e2e/.auth/
tests/e2e/captures/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.masking-wire/
reference/competitor-videos/

# internal layer — tracked in the private meal-app-internal repo (.git-internal)
/docs/
/reference/
/CLAUDE.md
/AGENTS.md
/.claude/
/.git-internal/
/.env.example
