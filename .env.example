# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# OpenAI (AI provider)
OPENAI_API_KEY=

# Jina Reader (optional — fallback for bot-protected recipe URLs)
JINA_API_KEY=

# Closed-beta access gates (both OPTIONAL; unset = gate off).
# Leave both blank locally and in CI — the app behaves as if neither exists.
#
# SITE_ACCESS_CODE: hides the whole app, login screen included, behind
# /invite?code=<this>. Anyone without the cookie gets a flat 404.
SITE_ACCESS_CODE=
# ALLOWED_EMAILS: comma-separated list of Google accounts allowed to hold an
# account. Unset means open signup, which is the public-launch state.
ALLOWED_EMAILS=

# Test-mode controls (You tab). Comma-separated. Unset = nobody, which is the
# OPPOSITE default to ALLOWED_EMAILS above — see src/lib/access.ts.
DEV_TOOLS_EMAILS=
