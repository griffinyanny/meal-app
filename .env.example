# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# OpenAI (AI provider)
OPENAI_API_KEY=

# Jina Reader (optional — fallback for bot-protected recipe URLs)
JINA_API_KEY=

# Closed-beta access gates (both OPTIONAL; unset = gate off).
# Leave both blank locally and in CI — the app behaves as if neither exists.
#
# SITE_ACCESS_CODE: hides the whole app, login screen included, behind
# /invite?code=<this>. Anyone without the cookie gets a flat 404.
SITE_ACCESS_CODE=
# ALLOWED_EMAILS: comma-separated list of Google accounts allowed to hold an
# account. Unset means open signup, which is the public-launch state.
ALLOWED_EMAILS=

# Test-mode controls (You tab). Comma-separated. Unset = nobody, which is the
# OPPOSITE default to ALLOWED_EMAILS above — see src/lib/access.ts.
DEV_TOOLS_EMAILS=

# Observability (1F/D3). ALL OPTIONAL — unset means analytics and error
# tracking are simply off, which is the correct local-dev and CI state.
#
# PostHog: product analytics + session replay. The KEY is what enables the
# whole pipeline (an allow-list, not a denylist — see src/lib/analytics).
# ⚠️ Both Playwright configs pin this to "" in webServerEnv so no automated run
# can ever report. Do not remove those lines; analytics-config.test.ts fails.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com when unset.
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry: error tracking. Server + client DSN (the same value; it is not a
# secret — it only accepts events, it cannot read them).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time source-map upload only. This one IS a secret. Set in Vercel, never
# locally — the upload step is skipped when it is absent.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
